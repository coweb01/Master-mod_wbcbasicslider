<?xml version="1.0" encoding="utf-8"?>
<extension type="module" client="site" method="upgrade">
    <name>Wbc Basis-Slider</name>
    <title>MOD_WBCBASICSLIDER</title>
    <description>MOD_WBCBASICSLIDER_DESC</description>
    <author>c. oerter</author>
    <version>1.0.0</version>
    <creationDate>September 2025</creationDate>
    <files>
        <filename module="mod_wbcbasicslider">mod_wbcbasicslider.php</filename>
        <filename>helper.php</filename>
        <folder>tmpl</folder>
    </files>
    <languages>
        <language tag="de-DE">language/de-DE/mod_wbcbasicslider.ini</language>
        <language tag="de-DE">language/de-DE/mod_wbcbasicslider.sys.ini</language>
        <language tag="en-GB">language/en-GB/mod_wbcbasicslider.ini</language>
        <language tag="en-GB">language/en-GB/mod_wbcbasicslider.sys.ini</language>
    </languages>
    <media destination="mod_wbcbasicslider" folder="media">
		<folder>css</folder>
		<folder>js</folder>
	</media>
    <config>
        <fields name="params">
            <fieldset name="MOD_WBCBASICSLIDER_SETTINGS" label="MOD_WBCBASICSLIDER_SETTINGS">
                <field 
                    name="perSlide" 
                    type="text" 
                    label="MOD_WBCBASICSLIDER_PER_SLIDE" 
                />
                <field 
                    name="controlcolor" 
                    type="list" 
                    label="MOD_WBCBASICSLIDER_CONTROL_COLOR" 
                    default="carousel-dark"
                    class="form-select">
                    <option value="carousel-dark">MOD_WBCBASICSLIDER_CONTROL_COLOR_DARK</option>
                    <option value="carousel-light">MOD_WBCBASICSLIDER_CONTROL_COLOR_LIGHT</option>
                </field>
            </fieldset>
             <fieldset name="MOD_WBCBASICSLIDER_SLIDES" label="MOD_WBCBASICSLIDER_SLIDES">
                <field name="sliderimages" type="subform" label="images" multiple="true">
                    <form>
                        <fields>
                            <fieldset name="images">
                                <field
                                    name="slide_image"
                                    type="media"
                                    required="true"
                                    default=""
                                    label="MOD_WBCBASICSLIDER_IMAGE"
                                    />                                
                                <field name="slide_alt" 
                                    type="text" 
                                    label="MOD_WBCBASICSLIDER_ALT" 
                                    default=""    
                                    description="MOD_WBCBASICSLIDER_ALT_DESC"
                                    />
                                <field name="slide_caption" 
                                    type="text" 
                                    label="MOD_WBCBASICSLIDER_CAPTION" 
                                    default=""    
                                    description="MOD_WBCBASICSLIDER_CAPTION_DESC"
                                    />    
                                <field
                                    name="slide_link_intern"
                                    type="menuitem"
                                    default=""
                                    label="MOD_WBCBASICSLIDER_LINK"
                                    description="MOD_WBCBASICSLIDER_LINK_DESC"
                                    >
                                    <option value="">MOD_WBCBASICSLIDER_MENU</option>
                                </field>
                                <field 
                                    name="slide_link_extern" 
                                    type="text" 
                                    label="MOD_WBCBASICSLIDER_LINK_EXTERN" 
                                    default=""    
                                    description="MOD_WBCBASICSLIDER_LINK_EXTERN_DESC"
                                    filter="url"
                                />
                            </fieldset>
                        </fields>
                    </form>
                </field>
             </fieldset>
            <fieldset name="advanced">
				<field
					name="layout"
					type="modulelayout"
					label="JFIELD_ALT_LAYOUT_LABEL"
					class="form-select"
					validate="moduleLayout"
				/>

				<field
					name="moduleclass_sfx"
					type="textarea"
					label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL"
					rows="3"
					validate="CssIdentifier"
				/>

				<field
					name="cache"
					type="list"
					label="COM_MODULES_FIELD_CACHING_LABEL"
					default="1"
					filter="integer"
					validate="options"
					>
					<option value="1">JGLOBAL_USE_GLOBAL</option>
					<option value="0">COM_MODULES_FIELD_VALUE_NOCACHING</option>
				</field>

				<field
					name="cache_time"
					type="number"
					label="COM_MODULES_FIELD_CACHE_TIME_LABEL"
					default="900"
					filter="integer"
				/>

				<field
					name="cachemode"
					type="hidden"
					default="static"
					>
					<option value="static"></option>
				</field>
			</fieldset>
        </fields>
    </config>
</extension>
